# ===== 复制为 .env 并填入真实值（.env 不入 git） =====

# --- 模型（OpenAI 兼容协议）---
# 主力：火山方舟 Coding Plan
ARK_API_KEY=
# 降级：DeepSeek 官方 API
DEEPSEEK_API_KEY=

# --- 文档解析（可留空：走本地 pymupdf 直读）---
LAYOUT_PARSING_URL=
LAYOUT_PARSING_TOKEN=

# --- 服务 ---
# skill / 前端 → 后端 的共享访问令牌（必填）
X_API_KEY=

# --- 端口 ---
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173

# --- 阈值（可选，优先级高于 config/thresholds.yml）---
# THRESH_GENERAL=40
# THRESH_SPECIFIC=20
# THRESH_TOTAL=45

# --- 飞书（可选）---
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_CHAT_WHITELIST=
# RESUME_DEFAULT_JD=
