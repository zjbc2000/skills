# ===== 复制为 .env 并填入真实值 =====

# --- 模型（SPEC §5.1）---
# 主力：火山方舟 Coding Plan（OpenAI 兼容）
ARK_API_KEY=
# 降级：DeepSeek 官方 API
DEEPSEEK_API_KEY=

# --- 文档解析（SPEC §5.3）---
# layout-parsing（百度 AI Studio 部署服务）
LAYOUT_PARSING_URL=https://c0y6l9xfsfh78edf.aistudio-app.com/layout-parsing
LAYOUT_PARSING_TOKEN=

# --- 飞书（SPEC §6）---
# 企业自建应用凭据（open.feishu.cn → 凭证与基础信息）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 允许响应的群 chat_id 白名单，逗号分隔（空 = 不响应任何群）
FEISHU_CHAT_WHITELIST=
# bot 筛选简历时使用的默认岗位 key（对应 jd_map.yml）
RESUME_DEFAULT_JD=

# --- 服务（SPEC §9）---
# skill / 前端 → 后端 的共享访问令牌
X_API_KEY=

# --- 端口（后端 python3 -m backend.cli.api；前端 web/.env 或 vite 自动读根 .env）---
# API_HOST=127.0.0.1
# API_PORT=8000
# WEB_PORT=5173

# --- 前端（web/.env，Vite 环境变量）---
# VITE_API_BASE=http://localhost:8000
# VITE_API_KEY=<与 X_API_KEY 相同>

# --- 阈值（SPEC §3.3）---
# 判定阈值在 config/thresholds.yml 维护（非环境变量），用真实数据集 + 阈值扫描校准
